# Copy to .env and fill in. NEVER commit .env.

# === Instagram account ===
# Use a DEDICATED burner/secondary account that is a member of the target group.
# Do NOT use your main account — private-API automation risks checkpoint/ban.
IG_USERNAME=
IG_PASSWORD=
# Optional base32 TOTP seed from an authenticator app (preferred over SMS 2FA).
# instagrapi generates codes via Client.totp_generate_code(seed).
IG_TOTP_SEED=

# === Target group thread ===
# The Direct group thread id the bot watches. Leave blank and run the
# list-threads helper once to discover it, then paste it here.
IG_THREAD_ID=

# === Session & storage ===
# Local default is ./data; on Fly this is overridden to the /data volume (fly.toml).
# Persisted instagrapi session/device blob — reused so the bot does NOT
# re-login on every start (fresh logins are themselves a ban signal).
IG_SESSION_PATH=./data/session.json
# SQLite database of seen media + already-processed message ids.
# Built ONCE by the manual backfill script, then shipped to Fly as-is.
DB_PATH=./data/inshust.db

# === Proxy (recommended to lower ban risk; residential/mobile preferred) ===
# e.g. http://user:pass@host:port — blank = use the host's IP (higher risk).
IG_PROXY=

# === Listener behavior (the always-on bot) ===
# Timezone used in the "already sent at <time>" reply text.
TZ=Asia/Taipei
# Polling safety-net interval (MQTT realtime is the primary fast path).
POLL_INTERVAL_SECONDS=45
# Random delay range (seconds) between API actions, to reduce detection.
ACTION_DELAY_MIN=1
ACTION_DELAY_MAX=3
LOG_LEVEL=INFO

# === One-time history backfill (separate manual script, run locally ONCE) ===
# The bot does NOT backfill on start. You run the backfill script by hand to
# pre-populate ./data/inshust.db from the group's full history, then ship that
# db file to Fly. Pacing is deliberately human-like to avoid detection:
BACKFILL_DELAY_MIN=2
BACKFILL_DELAY_MAX=6
# Optional cap on how many past messages to walk (blank = full history).
BACKFILL_MAX_MESSAGES=
